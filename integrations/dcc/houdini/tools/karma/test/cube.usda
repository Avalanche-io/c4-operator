#usda 1.0
(
    doc = "The karma tool's test stage: a cube under a distant light, a camera, and render settings writing one small image to render/cube.0001.exr in the job's tree."
    defaultPrim = "World"
    startTimeCode = 1
    endTimeCode = 1
    timeCodesPerSecond = 24
    framesPerSecond = 24
    metersPerUnit = 1
    upAxis = "Y"
    renderSettingsPrimPath = "/Render/rendersettings"
)

def Scope "Render"
{
    def RenderSettings "rendersettings"
    {
        rel camera = </World/cam>
        int2 resolution = (64, 64)
        rel products = </Render/Products/beauty>
        token[] includedPurposes = ["default", "render"]
    }

    def Scope "Products"
    {
        def RenderProduct "beauty"
        {
            token productName = "render/cube.0001.exr"
            token productType = "raster"
            rel orderedVars = </Render/Products/Vars/C>
        }

        def Scope "Vars"
        {
            def RenderVar "C"
            {
                string sourceName = "C"
                token sourceType = "raw"
                token dataType = "color4f"
            }
        }
    }
}

def Xform "World"
{
    def Cube "cube"
    {
        double size = 1
        float3 xformOp:rotateXYZ = (20, 35, 0)
        uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
        color3f[] primvars:displayColor = [(0.62, 0.40, 0.22)]
    }

    def Camera "cam"
    {
        float focalLength = 35
        float horizontalAperture = 20.955
        float verticalAperture = 20.955
        float2 clippingRange = (0.1, 100)
        double3 xformOp:translate = (0, 0, 4)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def DistantLight "key"
    {
        float inputs:intensity = 3
        float3 xformOp:rotateXYZ = (-45, 30, 0)
        uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
    }
}
