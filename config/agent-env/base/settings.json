{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "c4-agent checkpoint --hook",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "c4-agent checkpoint --hook",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
