{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cccc.io/schema/tool-1.schema.json",
  "title": "C4 tool definition (c4: tool/1)",
  "description": "How one kind of work runs: the command for one unit, its parameters, what it reads and writes, what it needs, how its progress and errors are read, and a test. A tool's parameters are OpenJD job parameter definitions with three C4 fields added (show, from, affectsOutput). The tool format's design has a worked example of each field. This schema checks the shape; the farm's check adds what needs the farm (format strings, pools, licences, the test run).",
  "type": "object",
  "required": ["c4", "name", "kind", "runs"],
  "additionalProperties": false,
  "properties": {
    "c4": {"const": "tool/1"},
    "name": {"$ref": "#/$defs/toolName"},
    "title": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "owner": {"type": "string", "minLength": 1},
    "docs": {"type": "string", "minLength": 1},
    "kind": {
      "enum": ["frames", "once", "shards", "generator", "check", "agent", "train"],
      "description": "What one unit of the tool is: a chunk of frames, one run, one shard, an evaluation that emits units, a review that writes a verdict, an agent's turn at a block, or a training run."
    },
    "runs": {"$ref": "#/$defs/runs"},
    "params": {"type": "array", "items": {"$ref": "#/$defs/param"}},
    "frames": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "chunk": {"type": "integer", "minimum": 1},
        "order": {"enum": ["binary", "sequential", "reverse"]}
      }
    },
    "writes": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "previews": {"type": "string", "minLength": 1},
    "needs": {"$ref": "#/$defs/needs"},
    "progress": {"type": "array", "items": {"$ref": "#/$defs/progressRule"}},
    "errors": {
      "type": "object",
      "additionalProperties": false,
      "description": "Lines that classify a failure: licence (no retry spent), permanent (no retries), question (a fact only a person has), retry (the default); ignore lists known-harmless lines.",
      "properties": {
        "licence": {"$ref": "#/$defs/patterns"},
        "permanent": {"$ref": "#/$defs/patterns"},
        "question": {"$ref": "#/$defs/patterns"},
        "retry": {"$ref": "#/$defs/patterns"},
        "ignore": {"$ref": "#/$defs/patterns"}
      }
    },
    "stall": {
      "type": "object",
      "additionalProperties": false,
      "required": ["quietMinutes"],
      "properties": {"quietMinutes": {"type": "integer", "minimum": 1}}
    },
    "retries": {"type": "integer", "minimum": 0},
    "retryOn": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"exitCodes": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1, "maximum": 255}}}
    },
    "reuse": {"enum": ["exact", "never"]},
    "emits": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/toolName"}},
    "judges": {"enum": ["frames", "units", "outputs"]},
    "rework": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxPasses": {"type": "integer", "minimum": 0},
        "onExhausted": {"type": "string", "pattern": "^(escalate(:\\S+)?|accept|fail)$"}
      }
    },
    "gate": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "aiUsage": {"type": "object", "minProperties": 1},
    "test": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tree"],
      "properties": {
        "tree": {"type": "string", "minLength": 1},
        "frames": {"$ref": "#/$defs/frames"},
        "with": {"type": "object"},
        "expect": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "kubernetes": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "description": "A typed overlay of pod and container fields, merged last. Needs a farm admin's approval at publish, and still passes the namespace's Pod Security level.",
      "properties": {
        "pod": {"type": "object"},
        "container": {"type": "object"}
      }
    }
  },
  "allOf": [
    {"if": {"properties": {"kind": {"const": "generator"}}, "required": ["kind"]}, "else": {"not": {"required": ["emits"]}}},
    {"if": {"properties": {"kind": {"const": "check"}}, "required": ["kind"]}, "else": {"not": {"anyOf": [{"required": ["judges"]}, {"required": ["rework"]}]}}},
    {"if": {"properties": {"kind": {"enum": ["frames", "generator"]}}, "required": ["kind"]}, "else": {"not": {"required": ["frames"]}}}
  ],
  "$defs": {
    "toolName": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$"},
    "size": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?[KMGT]i?$", "description": "A quantity with its unit: 64G, 512M, 1.5T."},
    "frames": {
      "oneOf": [
        {"type": "integer", "minimum": 0},
        {"type": "string", "pattern": "^[0-9]+(-[0-9]+(:[1-9][0-9]*)?)?(,[0-9]+(-[0-9]+(:[1-9][0-9]*)?)?)*$"}
      ]
    },
    "patterns": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "runs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command"],
      "anyOf": [{"required": ["image"]}, {"required": ["host"]}],
      "description": "How one unit runs: a command (an argument list with {{ }} format strings) in a container image, on a host runner, or either.",
      "properties": {
        "image": {"type": "string", "minLength": 1},
        "exe": {"type": "string", "minLength": 1},
        "host": {
          "type": "object",
          "additionalProperties": false,
          "required": ["has"],
          "properties": {
            "has": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$"}},
            "exe": {
              "type": "object",
              "additionalProperties": false,
              "minProperties": 1,
              "properties": {
                "linux": {"type": "string", "minLength": 1},
                "windows": {"type": "string", "minLength": 1},
                "macos": {"type": "string", "minLength": 1}
              }
            }
          }
        },
        "command": {
          "type": "array",
          "minItems": 1,
          "description": "An argument list, never one shell string.",
          "items": {"type": "string"}
        },
        "env": {
          "type": "object",
          "description": "Variables to add. The farm's own C4_ variables cannot be set.",
          "propertyNames": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$", "not": {"pattern": "^C4_"}},
          "additionalProperties": {"type": "string"}
        },
        "workdir": {"type": "string", "minLength": 1},
        "sidecars": {
          "type": "array",
          "description": "Servers that run beside the unit for its whole run, each found at $C4_TOOL_<NAME> (http://localhost:<port>).",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "image", "port"],
            "properties": {
              "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,30}$"},
              "image": {"type": "string", "minLength": 1},
              "args": {"type": "array", "items": {"type": "string"}},
              "env": {
                "type": "object",
                "propertyNames": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$", "not": {"pattern": "^C4_"}},
                "additionalProperties": {"type": "string"}
              },
              "port": {"type": "integer", "minimum": 1, "maximum": 65535}
            }
          }
        }
      }
    },
    "needs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cpu": {"type": "number", "exclusiveMinimum": 0},
        "memory": {"$ref": "#/$defs/size"},
        "gpu": {"type": "integer", "minimum": 0},
        "gpuMemory": {"$ref": "#/$defs/size"},
        "scratch": {"$ref": "#/$defs/size"},
        "farm": {"enum": ["read", "job", "project"], "description": "What a unit may do on the farm itself, through the HUD and MCP: read, job (also act on its own job), project (also submit in its project). Unset, nothing."},
        "licences": {
          "type": "object",
          "description": "Seats per unit, as pool/feature: count.",
          "propertyNames": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*/[A-Za-z0-9_.-]+$"},
          "additionalProperties": {"type": "integer", "minimum": 1}
        },
        "network": {
          "type": "array",
          "uniqueItems": true,
          "description": "What a unit may reach: licences (the servers of the pools it names), or services the farm admin defined. Empty, the default, is sealed.",
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}
        },
        "sizes": {
          "type": "object",
          "propertyNames": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "minProperties": 1,
            "properties": {
              "cpu": {"type": "number", "exclusiveMinimum": 0},
              "memory": {"$ref": "#/$defs/size"},
              "gpu": {"type": "integer", "minimum": 0},
              "gpuMemory": {"$ref": "#/$defs/size"},
              "scratch": {"$ref": "#/$defs/size"}
            }
          }
        }
      }
    },
    "progressRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["match"],
      "oneOf": [{"required": ["percent"]}, {"required": ["frame"]}],
      "properties": {
        "match": {"type": "string", "minLength": 1, "description": "A regular expression (RE2) over one log line."},
        "percent": {"type": "integer", "minimum": 1, "description": "The capture group holding the percent done."},
        "frame": {"type": "integer", "minimum": 1, "description": "The capture group holding a finished frame."}
      }
    },
    "fileFilter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "patterns"],
      "properties": {
        "label": {"type": "string", "minLength": 1},
        "patterns": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "userInterface": {
      "type": "object",
      "additionalProperties": false,
      "description": "OpenJD's hints for drawing a parameter. Hints, never constraints.",
      "properties": {
        "control": {
          "enum": [
            "LINE_EDIT", "MULTILINE_EDIT", "DROPDOWN_LIST", "CHECK_BOX", "SPIN_BOX", "HIDDEN",
            "CHOOSE_INPUT_FILE", "CHOOSE_OUTPUT_FILE", "CHOOSE_DIRECTORY",
            "LINE_EDIT_LIST", "SPIN_BOX_LIST", "CHECK_BOX_LIST",
            "CHOOSE_INPUT_FILE_LIST", "CHOOSE_OUTPUT_FILE_LIST", "CHOOSE_DIRECTORY_LIST"
          ]
        },
        "label": {"type": "string", "minLength": 1},
        "groupLabel": {"type": "string", "minLength": 1},
        "singleStepDelta": {"type": "number", "exclusiveMinimum": 0},
        "decimals": {"type": "integer", "minimum": 0},
        "fileFilters": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/fileFilter"}},
        "fileFilterDefault": {"$ref": "#/$defs/fileFilter"}
      }
    },
    "param": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "description": "An OpenJD job parameter definition, field for field, plus show, from and affectsOutput.",
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"},
        "type": {
          "enum": ["STRING", "PATH", "INT", "FLOAT", "BOOL", "RANGE_EXPR",
                   "LIST[STRING]", "LIST[PATH]", "LIST[INT]", "LIST[FLOAT]", "LIST[BOOL]", "LIST[LIST[INT]]"]
        },
        "description": {"type": "string"},
        "default": {},
        "allowedValues": {"type": "array", "minItems": 1},
        "minValue": {"type": "number"},
        "maxValue": {"type": "number"},
        "minLength": {"type": "integer", "minimum": 0},
        "maxLength": {"type": "integer", "minimum": 0},
        "objectType": {"enum": ["FILE", "DIRECTORY"]},
        "dataFlow": {"enum": ["NONE", "IN", "OUT", "INOUT"]},
        "userInterface": {"$ref": "#/$defs/userInterface"},
        "show": {"enum": ["artist", "advanced", "wrangler", "hidden"]},
        "from": {"enum": ["shot.frames", "scene.frames", "scene.file", "scene.selection", "scene.renderables", "scene.camera", "milestone"]},
        "affectsOutput": {"type": "boolean"}
      },
      "allOf": [
        {"if": {"properties": {"type": {"enum": ["PATH", "LIST[PATH]"]}}}, "else": {"not": {"anyOf": [{"required": ["objectType"]}, {"required": ["dataFlow"]}]}}},
        {"if": {"properties": {"type": {"const": "STRING"}}}, "then": {"properties": {"userInterface": {"properties": {"control": {"enum": ["LINE_EDIT", "MULTILINE_EDIT", "DROPDOWN_LIST", "CHECK_BOX", "HIDDEN"]}}}}}},
        {"if": {"properties": {"type": {"const": "PATH"}}}, "then": {"properties": {"userInterface": {"properties": {"control": {"enum": ["CHOOSE_INPUT_FILE", "CHOOSE_OUTPUT_FILE", "CHOOSE_DIRECTORY", "DROPDOWN_LIST", "HIDDEN"]}}}}}},
        {"if": {"properties": {"type": {"enum": ["INT", "FLOAT"]}}}, "then": {"properties": {"userInterface": {"properties": {"control": {"enum": ["SPIN_BOX", "DROPDOWN_LIST", "HIDDEN"]}}}}}},
        {"if": {"properties": {"type": {"const": "BOOL"}}}, "then": {"properties": {"userInterface": {"properties": {"control": {"enum": ["CHECK_BOX", "HIDDEN"]}}}}}},
        {"if": {"properties": {"type": {"const": "RANGE_EXPR"}}}, "then": {"properties": {"userInterface": {"properties": {"control": {"enum": ["LINE_EDIT", "HIDDEN"]}}}}}},
        {"if": {"properties": {"type": {"const": "LIST[STRING]"}}}, "then": {"properties": {"userInterface": {"properties": {"control": {"enum": ["LINE_EDIT_LIST", "HIDDEN"]}}}}}},
        {"if": {"properties": {"type": {"const": "LIST[PATH]"}}}, "then": {"properties": {"userInterface": {"properties": {"control": {"enum": ["CHOOSE_INPUT_FILE_LIST", "CHOOSE_OUTPUT_FILE_LIST", "CHOOSE_DIRECTORY_LIST", "HIDDEN"]}}}}}},
        {"if": {"properties": {"type": {"enum": ["LIST[INT]", "LIST[FLOAT]"]}}}, "then": {"properties": {"userInterface": {"properties": {"control": {"enum": ["SPIN_BOX_LIST", "HIDDEN"]}}}}}},
        {"if": {"properties": {"type": {"const": "LIST[BOOL]"}}}, "then": {"properties": {"userInterface": {"properties": {"control": {"enum": ["CHECK_BOX_LIST", "HIDDEN"]}}}}}},
        {"if": {"properties": {"type": {"const": "LIST[LIST[INT]]"}}}, "then": {"properties": {"userInterface": {"properties": {"control": {"const": "HIDDEN"}}}}}}
      ]
    }
  }
}
