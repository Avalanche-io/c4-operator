#!/bin/sh
# c4-render-usd: render a USD stage with Blender's Cycles, taking usdrecord's
# command line (installed as usdrecord in the fallback hydra image):
#
#   usdrecord [--renderer NAME] [--frames A:B] [--imageWidth W] [--disableGpu] STAGE OUTPUT
#
# OUTPUT holds #### where the frame number goes, as with usdrecord. The
# renderer is always Cycles on the CPU; other --renderer names are refused
# so a job never silently renders with something it did not ask for.
set -eu

renderer=Cycles
frames=
width=1920
while [ $# -gt 2 ]; do
  case "$1" in
    --renderer|-r) renderer=$2; shift 2 ;;
    --frames|-f) frames=$2; shift 2 ;;
    --imageWidth|-w) width=$2; shift 2 ;;
    --disableGpu) shift ;;
    *) echo "c4-render-usd: unknown option $1" >&2; exit 2 ;;
  esac
done
if [ $# -ne 2 ]; then
  echo "usage: usdrecord [--renderer Cycles] [--frames A:B] [--imageWidth W] STAGE OUTPUT" >&2
  exit 2
fi
case "$renderer" in
  Cycles|cycles) ;;
  *) echo "c4-render-usd: this image renders with Cycles only, not $renderer" >&2; exit 2 ;;
esac
start=${frames%%:*}
end=${frames##*:}
[ -n "$frames" ] || { start=1; end=1; }

exec blender -b --factory-startup --python /opt/c4/render_usd.py -- \
  --stage "$1" --output "$2" --start "$start" --end "$end" --width "$width"
