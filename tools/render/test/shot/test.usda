#usda 1.0
(
    doc = "The render tool's test stage: a sphere on a ground plane, a shot camera that dollies in, and render settings that name it."
    defaultPrim = "World"
    startTimeCode = 1001
    endTimeCode = 1002
    timeCodesPerSecond = 24
    framesPerSecond = 24
    metersPerUnit = 1
    upAxis = "Y"
)

def "Render"
{
    def RenderSettings "settings"
    {
        rel camera = </World/cam/shotCam>
        int2 resolution = (64, 36)
        token[] includedPurposes = ["default", "render"]
    }
}

def Xform "World"
{
    def Sphere "ball"
    {
        double radius = 0.5
        double3 xformOp:translate = (0, 0.5, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        color3f[] primvars:displayColor = [(0.62, 0.40, 0.22)]
    }

    def Mesh "ground"
    {
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(-5, 0, 5), (5, 0, 5), (5, 0, -5), (-5, 0, -5)]
        color3f[] primvars:displayColor = [(0.22, 0.20, 0.12)]
    }

    def Xform "cam"
    {
        def Camera "shotCam"
        {
            float focalLength = 35
            float horizontalAperture = 36
            float verticalAperture = 20.25
            float2 clippingRange = (0.1, 100)
            double3 xformOp:translate.timeSamples = {
                1001: (0, 1, 5),
                1002: (0, 1, 4.5),
            }
            float3 xformOp:rotateXYZ = (-6, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
        }
    }

    def DistantLight "key"
    {
        float inputs:intensity = 3
        float inputs:angle = 1.5
        color3f inputs:color = (1.0, 0.72, 0.48)
        float3 xformOp:rotateXYZ = (-30, -60, 0)
        uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
    }

    def DomeLight "sky"
    {
        float inputs:intensity = 0.6
        color3f inputs:color = (0.45, 0.52, 0.70)
    }
}
